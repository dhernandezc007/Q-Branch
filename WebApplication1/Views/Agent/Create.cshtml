
@model List<WebApplication1.Models.AgentModel>

@{
    ViewData["Title"] = "Agent Registration";
    ViewData["Section"] = "PERSONNEL / NEW RECORD";
}

<div class="create-page">
    <div class="page-eyebrow">
        <span class="status-dot"></span>
        PERSONNEL DIVISION
        <span class="eyebrow-divider">/</span>
        NEW RECORD
    </div>

    <div class="create-heading">
        <div>
            <h1>Agent <span>Registration</span></h1>
            <p>
                Establish a new personnel record in the intelligence directory.
            </p>
        </div>

        <div class="record-stamp">
            <span>DOCUMENT</span>
            <strong>001-A</strong>
            <span>CONFIDENTIAL</span>
        </div>
    </div>

    <!-- Agent registration form -->
    <div class="form-panel">
        <div class="form-panel-header">
            <div>
                <span class="panel-index">01</span>
                <span class="panel-title">PERSONNEL DETAILS</span>
            </div>
            <span class="panel-code">SIS / REGISTRY</span>
        </div>

        <form asp-controller="Agent"
              asp-action="Create"
              method="post">

            <div class="form-grid">
                <div class="form-field">
                    <label for="id">AGENT IDENTIFIER</label>
                    <input id="id" name="id"
                           class="form-input"
                           placeholder="e.g. 007"
                           autocomplete="off"
                           required />
                    <span class="field-hint">
                        UNIQUE PERSONNEL REFERENCE
                    </span>
                </div>

                <div class="form-field">
                    <label for="name">FULL NAME</label>
                    <input id="name" name="name"
                           class="form-input"
                           placeholder="Enter full name"
                           autocomplete="off"
                           required />
                    <span class="field-hint">
                        LEGAL OR REGISTERED NAME
                    </span>
                </div>

                <div class="form-field">
                    <label for="nationality">NATIONALITY</label>
                    <input id="nationality" name="nationality"
                           class="form-input"
                           placeholder="Enter nationality"
                           autocomplete="off"
                           required />
                    <span class="field-hint">
                        COUNTRY OF NATIONALITY
                    </span>
                </div>

                <div class="form-field">
                    <label for="organization">ORGANIZATION</label>
                    <input id="organization" name="organization"
                           class="form-input"
                           placeholder="Enter organization"
                           autocomplete="off"
                           required />
                    <span class="field-hint">
                        CURRENT AFFILIATION
                    </span>
                </div>

                <!-- New agent status dropdown -->
                <div class="form-field">
                    <label for="status">AGENT STATUS</label>
                    <select id="status" name="status"
                            class="form-input" required>
                        <option value="Active" selected>Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                    <span class="field-hint">
                        CURRENT OPERATIONAL STATUS
                    </span>
                </div>
            </div>

            <div class="form-footer">
                <div class="required-note">
                    <span>*</span> ALL FIELDS REQUIRED
                </div>

                <button type="submit" class="submit-button">
                    REGISTER PERSONNEL
                    <span>→</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Current agents list -->
    <div class="form-panel" style="margin-top: 24px;">
        <div class="form-panel-header">
            <div>
                <span class="panel-index">02</span>
                <span class="panel-title">CURRENT AGENTS</span>
            </div>
            <span class="panel-code">@Model.Count RECORD(S)</span>
        </div>

        @if (Model.Count == 0)
        {
            <p>No agents registered yet.</p>
        }
        else
        {
            @foreach (var agent in Model)
            {
                <div class="agent-row">
                    <div>
                        <p><strong>ID:</strong> @agent.Id</p>
                        <p><strong>NAME:</strong> @agent.Name</p>
                        <p><strong>NATIONALITY:</strong> @agent.Nationality</p>
                        <p><strong>ORGANIZATION:</strong> @agent.Organization</p>
                        <p><strong>STATUS:</strong> @agent.Status</p>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Security notice -->
    <div class="security-note">
        <span class="security-mark">i</span>
        <p>
            <strong>HANDLING NOTICE</strong>
            <span>
                Personnel information should be accurate and handled
                in accordance with applicable access policies.
            </span>
        </p>
        <span class="security-reference">REF. SIS-01</span>
    </div>
</div>

